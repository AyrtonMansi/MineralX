{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "app/api/ops/export/route 2.ts",
    "app/api/plant/notes/route 2.ts",
    "app/ops/plant/page 2.tsx",
    "components/ops/Home 2.tsx",
    "components/ops/OperationsShell 2.tsx",
    "components/ops/Reports 2.tsx",
    "tests/plant/public-page.test 2.ts"
  ]
}

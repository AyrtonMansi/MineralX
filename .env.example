# Hosted MineralX application and Supabase project. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_with_a_server_only_secret

# Canonical public MCP resource. These two values must resolve to the same URL.
MINERALX_PUBLIC_ORIGIN=https://staging.example.com
MINERALX_MCP_AUDIENCE=https://staging.example.com/api/mcp
MINERALX_MCP_ALLOWED_HOSTS=staging.example.com
MINERALX_MCP_ALLOWED_ORIGINS=https://chatgpt.com
MINERALX_MCP_ALLOWED_CLIENT_IDS=replace_after_registering_the_approved_oauth_client
MINERALX_MCP_REQUIRE_OAUTH_CLIENT=on

# Only allow provider-hosted file URLs that have been explicitly approved.
MINERALX_MCP_FILE_HOSTS=approved-provider-download-host.example.com

# Model processing is separately gated globally and per MineralX scope policy.
MINERALX_AI_EXTERNAL_PROCESSING=disabled
OPENAI_API_KEY=replace_with_a_server_only_key
MINERALX_AI_MODEL=gpt-5.5
# MINERALX_AI_RESPONSES_URL=https://api.openai.com/v1/responses

# Production scanning fails closed unless a scanner is configured.
MINERALX_FILE_SCAN_URL=https://scanner.internal.example.com/scan
MINERALX_FILE_SCAN_TOKEN=replace_with_a_server_only_token
